#!/bin/bash
# Derived from Coder Registry's coder-labs/opencode module and modified for this repository.
set -euo pipefail
umask 077

ARG_WORKDIR=$(echo -n '${ARG_WORKDIR}' | base64 -d)
ARG_WEB_PORT='${ARG_WEB_PORT}'

export PATH="$${HOME}/.opencode/bin:$${PATH}"
cd "$${ARG_WORKDIR}"

MODULE_DIR="$${HOME}/.coder-modules/fdobrovolny/opencode"
SERVER_LOG="$${MODULE_DIR}/logs/server.log"
SERVER_URL="http://127.0.0.1:$${ARG_WEB_PORT}"
mkdir -p "$${MODULE_DIR}/logs"

# Setting a service option stops the server, even if its value is unchanged.
# Preserve running sessions when Coder reruns the startup script.
if [ "$(opencode service get hostname)" != "127.0.0.1" ]; then
  opencode service set hostname 127.0.0.1
fi
if [ "$(opencode service get port)" != "$${ARG_WEB_PORT}" ]; then
  opencode service set port "$${ARG_WEB_PORT}"
fi

# OpenCode manages the detached process, its persistent password, and discovery.
# Native pairing and terminal clients therefore use this same server.
if ! opencode service start >> "$${SERVER_LOG}" 2>&1; then
  echo "ERROR: OpenCode service failed to start. Check $${SERVER_LOG}." >&2
  exit 1
fi

# /global/health is a v1 route; v2 may return the HTML shell for that path.
# Check the authenticated v2 API and the public browser shell separately.
OPENCODE_PASSWORD=$(opencode service get password)
export OPENCODE_PASSWORD
if ! opencode api --server "$${SERVER_URL}" GET /api/info > /dev/null; then
  echo "ERROR: OpenCode API is not ready at $${SERVER_URL}." >&2
  exit 1
fi
unset OPENCODE_PASSWORD
if ! curl -fsS -o /dev/null --max-time 10 "$${SERVER_URL}/"; then
  echo "ERROR: OpenCode web UI is not ready at $${SERVER_URL}." >&2
  exit 1
fi

echo "OpenCode service is ready at $${SERVER_URL}."
echo "To sign in through Coder, run: opencode pair --url <OpenCode-Web-app-URL>"
